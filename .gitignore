# Робочі теки (дані ігор, збірки, бекапи оригіналів)
/work/
/out/
/backup/
/_to_delete/
/_вхідні/
/_старі книги/
/кеш/

# Книги перекладача і локальні налаштування
/Переклад/
/settings.json
# звернення перекладача: ключ бота (передається файлом) і черга/надіслане
/звернення.key
/звернення/
/розділи.json
/лог.txt
~$*

# Файли ігор (великі, авторські)
*.cpk
/maryskelter/японська.json
/neptunia/японська.json
*.bra
*.pac
/text_dump.bin
/атлас/_огляд/
/атлас/*.png
/атлас/*.tid
/атлас/*.TI
/атлас/шрифти/мої/
# розмітка, яку зробив сам перекладач (накладається на основну; власник забирає «злити»)
/атлас/*.мої.json

# Збірка патча
/патч/*.obj
/патч/*.exp
/патч/*.lib
/патч/*.dll
# зібраний патч їде до перекладача через git: «2» кладе його поруч з грою
!/патч/dinput8.dll

# Службове
__pycache__/
*.pyc
ЗАВДАННЯ-*.md
CLAUDE.md
.claude/
